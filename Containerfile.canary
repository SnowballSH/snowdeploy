# The deploy-failure fixture image. It starts, binds, and answers 500 forever.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/canary-unhealthy ./cmd/canary-unhealthy
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" \
      -o /out/canary-unhealthy ./cmd/canary-unhealthy

FROM scratch
COPY --from=build /out/canary-unhealthy /canary-unhealthy
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["/canary-unhealthy"]
